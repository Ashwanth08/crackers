# =============================================================================
# Sri Crackers - Environment Variable Template (.env.example)
# =============================================================================
# PLACEHOLDER, NON-SECRET values for documentation only.
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is gitignored, so your secrets stay out of git.
# Uses plain SMTP via Nodemailer - NO AWS. Any SMTP provider works
# (Resend SMTP, SendGrid SMTP, or Gmail SMTP with an app password).
# =============================================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false            # true for port 465, false for 587 (STARTTLS)
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# From address shown on the email (for Gmail SMTP this must be your Gmail address)
MAIL_FROM="Sri Crackers <orders@example.com>"

# Owner inbox that receives each order
OWNER_EMAIL=owner@example.com

# Upstash Redis (REQUIRED on serverless hosts like Vercel; optional locally)
# When these are set, the order-ID counter and idempotency store use Redis
# instead of the local filesystem (Vercel has a read-only filesystem).
# Create a free database at https://console.upstash.com and copy the REST URL
# and REST token. Leave BLANK locally to use the file-based stores.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
